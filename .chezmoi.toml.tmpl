{{- $machine := dict -}}
{{- if hasKey . "machine" -}}
{{-   if not (kindIs "map" .machine) -}}
{{-     fail "data.machine must be a table" -}}
{{-   end -}}
{{-   $machine = deepCopy .machine -}}
{{- end -}}
{{/* Preserve the previous local work/personal choice during migration. */}}
{{- if and (not (hasKey $machine "scope")) (hasKey . "context") -}}
{{-   $_ := set $machine "scope" .context -}}
{{- end -}}
{{- if not (hasKey $machine "scope") -}}
{{-   $_ := set $machine "scope" (promptChoice "Scope" (list "personal" "work")) -}}
{{- end -}}
{{/* promptBool defaults to false on EOF; choices require an explicit answer. */}}
{{- range $key := list "mobile" "headless" -}}
{{-   if not (hasKey $machine $key) -}}
{{-     $answer := promptChoice ($key | title) (list "true" "false") -}}
{{-     if not (has $answer (list "true" "false")) -}}
{{-       fail (printf "Choose true or false explicitly for machine.%s" $key) -}}
{{-     end -}}
{{-     $_ := set $machine $key (eq $answer "true") -}}
{{-   end -}}
{{- end -}}
{{/* Vulkan is an explicit capability declaration, not a live hardware probe. */}}
{{- if and (eq .chezmoi.os "linux") (not (hasKey $machine "vulkan")) -}}
{{-   $_ := set $machine "vulkan" (promptChoice "Vulkan" (list "unknown" "none" "1.0" "1.1" "1.2" "1.3" "1.4")) -}}
{{- end -}}
{{/* Named templates are not loaded during init; includeTemplate reads the file. */}}
{{- includeTemplate "validate-machine" (dict "machine" $machine "chezmoi" .chezmoi) -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data.machine]
scope = {{ $machine.scope | quote }}
mobile = {{ $machine.mobile }}
headless = {{ $machine.headless }}
{{ if eq .chezmoi.os "linux" -}}
vulkan = {{ $machine.vulkan | quote }}
{{ end -}}
