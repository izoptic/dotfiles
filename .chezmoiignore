{{- template "validate-machine" . -}}
# The public repository description is not a home-directory target.
README.md

# Local-only configuration: never import it when adding a parent directory.
.config/chezmoi
.config/chezmoi/**
.config/zsh/local.zsh
.config/wezterm/local.lua

# Ghostty: one complete config for graphical personal macOS/Linux machines.
{{ if or .machine.headless (ne .machine.scope "personal") }}
.config/ghostty
.config/ghostty/**
{{ end }}

# WezTerm needs a graphical session; Linux Zed additionally needs Vulkan >= 1.3.
# One shared predicate keeps Zed configuration and provisioning in agreement.
{{ if .machine.headless }}
.config/wezterm
.config/wezterm/**
{{ end }}
{{ if ne (includeTemplate "zed-enabled" .) "true" }}
.config/zed
.config/zed/**
{{ end }}
